<Window x:Class="View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ViewModel;assembly=ViewModel"
        xmlns:conv="clr-namespace:View.Converters"
        xmlns:controls="clr-namespace:View.Controls"
        Title="Contacts" Height="450" Width="700">

    <Window.DataContext>
        <vm:MainVM/>
    </Window.DataContext>

    <Window.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <DataTemplate x:Key="ContactTemplate">
            <StackPanel Margin="3">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12"/>
                <TextBlock Text="{Binding PhoneNumber}" FontSize="10"/>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="3"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Background="#f8f8f8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Margin="8,8,8,3">
                <TextBlock Text="Find:" VerticalAlignment="Center" Margin="3"/>
                <TextBox Width="180" Margin="3"/>
            </StackPanel>

            <ListBox Grid.Row="1" Margin="8,3,8,3" 
                     ItemsSource="{Binding Contacts}" 
                     SelectedItem="{Binding SelectedContact}"
                     ItemTemplate="{StaticResource ContactTemplate}"/>

            <UniformGrid Grid.Row="2" Columns="3" Margin="8,3,8,8">
                <Button Content="Add" Height="25" Margin="3" Command="{Binding AddCommand}"/>
                <Button Content="Edit" Height="25" Margin="3" Command="{Binding EditCommand}"/>
                <Button Content="Remove" Height="25" Margin="3" Command="{Binding RemoveCommand}"/>
            </UniformGrid>
        </Grid>

        <GridSplitter Grid.Column="1" Width="3" HorizontalAlignment="Stretch" Background="White"/>

        <Grid Grid.Column="2" Background="White" Margin="8">
            <controls:ContactControl DataContext="{Binding EditableContact}" />

            <Button Content="Apply" Width="75" Height="25" Margin="115,180,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                    Command="{Binding ApplyCommand}" 
                    Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}"/>
        </Grid>
    </Grid>
</Window>